# テキストは LF で統一する（Godot が LF で書くため。autocrlf の設定が PC ごとに違っても差分が出ないように）
* text=auto eol=lf

# Windows のスクリプトは CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

